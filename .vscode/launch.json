{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "matcron",
      "cwd": "matcron",
      "request": "launch",
      "type": "dart",
      "program": "lib/app/main.dart"
    },
    {
      "name": "matcron (profile mode)",
      "cwd": "matcron",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/app/main.dart"
    },
    {
      "name": "matcron (release mode)",
      "cwd": "matcron",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/app/main.dart"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Matcron-Frontend/matcron/windows/flutter",
      "program": "c:/Matcron-Frontend/matcron/windows/flutter/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}